# Required: choose a strong password of at least 12 characters.
ADMIN_PASSWORD=
DATA_DIR=./data
# true behind HTTPS; false for local HTTP development.
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=120
# Optional stable Fernet key; otherwise DATA_DIR/vault.key is generated.
# VAULT_KEY=
# Optional Qwen egress proxy list file (one proxy per line).
# PROXY_FILE=/run/secrets/qwen_proxies
